# riff registry at riff.vaab.dev — install counts in sqlite riff_events (rig schema).
# Keep Db connect/execute/query inlined in each route (Vaab 0.1.3).

need rig from ./vendor/rig of RigError, ensure_schema, connect, connect_with, require_env, allow_table, list, list_where, get, insert_todo, insert_profile, patch_todo_done, remove, require_user, user_view, resolve_object, health, auth_health, Client, User, UserView, Health, NewTodo, OkCount, Todo, track_riff, count_riff, known_riff, riff_name_ok

type ServiceHealth {
    ok: Bool
    service: Text
}

type Tracked {
    ok: Bool
    downloads: Int
}

serve on port 8787 {
    route get "/health" {
        reply with ServiceHealth.new(ok: yes, service: "riff")
    }

    route get "/api/riffs" {
        match Db.connect("sqlite:riff-rig.db") {
            when success db then {
                let empty: [Text] = []
                match db.execute(
                    "create table if not exists riff_events (id text primary key, name text not null, kind text not null, ts text not null)",
                    empty,
                ) {
                    when success _ then match db.from("riff_events").all() {
                        when success rows then { reply with rows }
                        when failure error then { reply text "query" as "text/plain" status 500 }
                    }
                    when failure error then match error {
                        when Failed(message) then { reply text message as "text/plain" status 500 }
                    }
                }
            }
            when failure error then match error {
                when Failed(message) then { reply text message as "text/plain" status 500 }
            }
        }
    }

    route post "/api/riffs/rig/track" {
        match Db.connect("sqlite:riff-rig.db") {
            when success db then {
                let empty: [Text] = []
                match db.execute(
                    "create table if not exists riff_events (id text primary key, name text not null, kind text not null, ts text not null)",
                    empty,
                ) {
                    when success _ then match db.from("riff_events").insert({"id": "rig-install-{now()}", "name": "rig", "kind": "install", "ts": "{now()}"}) {
                        when success _ then { reply with Tracked.new(ok: yes, downloads: 0) }
                        when failure error then { reply text "track" as "text/plain" status 500 }
                    }
                    when failure error then match error {
                        when Failed(message) then { reply text message as "text/plain" status 500 }
                    }
                }
            }
            when failure error then match error {
                when Failed(message) then { reply text message as "text/plain" status 500 }
            }
        }
    }

    route post "/api/riffs/tape/track" {
        match Db.connect("sqlite:riff-rig.db") {
            when success db then {
                let empty: [Text] = []
                match db.execute(
                    "create table if not exists riff_events (id text primary key, name text not null, kind text not null, ts text not null)",
                    empty,
                ) {
                    when success _ then match db.from("riff_events").insert({"id": "tape-install-{now()}", "name": "tape", "kind": "install", "ts": "{now()}"}) {
                        when success _ then { reply with Tracked.new(ok: yes, downloads: 0) }
                        when failure error then { reply text "track" as "text/plain" status 500 }
                    }
                    when failure error then match error {
                        when Failed(message) then { reply text message as "text/plain" status 500 }
                    }
                }
            }
            when failure error then match error {
                when Failed(message) then { reply text message as "text/plain" status 500 }
            }
        }
    }

    route post "/api/riffs/supabase/track" {
        match Db.connect("sqlite:riff-rig.db") {
            when success db then {
                let empty: [Text] = []
                match db.execute(
                    "create table if not exists riff_events (id text primary key, name text not null, kind text not null, ts text not null)",
                    empty,
                ) {
                    when success _ then match db.from("riff_events").insert({"id": "supabase-install-{now()}", "name": "supabase", "kind": "install", "ts": "{now()}"}) {
                        when success _ then { reply with Tracked.new(ok: yes, downloads: 0) }
                        when failure error then { reply text "track" as "text/plain" status 500 }
                    }
                    when failure error then match error {
                        when Failed(message) then { reply text message as "text/plain" status 500 }
                    }
                }
            }
            when failure error then match error {
                when Failed(message) then { reply text message as "text/plain" status 500 }
            }
        }
    }

    route get "/" {
        reply file "web/dist/index.html"
    }

    route get "/packages/rig" {
        reply file "web/dist/index.html"
    }

    route get "/packages/tape" {
        reply file "web/dist/index.html"
    }

    route get "/packages/supabase" {
        reply file "web/dist/index.html"
    }

    route get "/assets/{*filepath}" {
        if filepath.contains("..") {
            reply text "forbidden" as "text/plain" status 403
        } else {
            reply file "web/dist/assets/{filepath}"
        }
    }

    route get "/favicon.svg" {
        reply file "web/dist/favicon.svg"
    }

    route get "/icons.svg" {
        reply file "web/dist/icons.svg"
    }

    route get "/vaab-mark.svg" {
        reply file "web/dist/vaab-mark.svg"
    }
}
