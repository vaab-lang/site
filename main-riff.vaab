# riff — package registry at riff.vaab.dev (rig mounts + Postgres on Render)
#
#   RIG_DATABASE_URL=sqlite:riff-rig.db vaab serve main-riff.vaab
#   Studio: http://127.0.0.1:8787/studio/  (Basic auth: admin / secret)

need rig

log.info("riff registry starting (rig mounts)")

serve on port 8787 {
    before every request {
        log.info("incoming {request.method} {request.path}")
    }

    mount rig_riff
}
