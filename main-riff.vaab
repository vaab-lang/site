# riff — package registry at riff.vaab.dev
#
# Download / install counts are stored through the **rig** riff (SQLite).
#
#   cd web && npm run build
#   vaab gather
#   RIG_DATABASE_URL=sqlite:riff-rig.db vaab serve main-riff.vaab

need rig from ./vendor/rig of RigError, open_url, track_riff, count_riff, riff_name_ok

type ServiceHealth {
    ok: Bool
    service: Text
}

type RiffStat {
    name: Text
    downloads: Int
}

type Tracked {
    ok: Bool
    downloads: Int
}

log.info("riff registry starting (rig-backed)")

open_registry_db() returns Db or fails RigError {
    let url = env.get("RIG_DATABASE_URL") otherwise "sqlite:riff-rig.db"
    return open_url(url)
}

list_stats() returns [RiffStat] or fails RigError {
    let db = try open_registry_db()
    let supabase = try count_riff(db, "supabase")
    let tape = try count_riff(db, "tape")
    let rig_count = try count_riff(db, "rig")
    return [
        RiffStat.new(name: "supabase", downloads: supabase),
        RiffStat.new(name: "tape", downloads: tape),
        RiffStat.new(name: "rig", downloads: rig_count),
    ]
}

riff_detail(name: Text) returns RiffStat or fails RigError {
    if not riff_name_ok(name) {
        fail RigError.BadRequest("riff not found")
    }
    let db = try open_registry_db()
    let downloads = try count_riff(db, name)
    return RiffStat.new(name: name, downloads: downloads)
}

track_download(name: Text) returns Tracked or fails RigError {
    if not riff_name_ok(name) {
        fail RigError.BadRequest("riff not found")
    }
    let db = try open_registry_db()
    let downloads = try track_riff(db, name, "install")
    return Tracked.new(ok: yes, downloads: downloads)
}

explain(error: RigError) returns Text {
    match error {
        when Missing(name) then { return "missing {name}" }
        when Database(message) then { return message }
        when Unauthorized then { return "unauthorized" }
        when BadRequest(message) then { return message }
        when NotFound(resource) then { return "not found: {resource}" }
        when Forbidden(table) then { return "forbidden {table}" }
        when Unsafe(requested) then { return "unsafe {requested}" }
    }
}

serve on port 8787 {
    before every request {
        log.info("incoming {request.method} {request.path}")
    }

    route get "/health" {
        reply with ServiceHealth.new(ok: yes, service: "riff")
    }

    route get "/api/riffs" {
        reply with try list_stats()
    }

    route get "/api/riffs/{name: Text}" {
        reply with try riff_detail(name)
    }

    route post "/api/riffs/{name: Text}/track" {
        reply with try track_download(name)
    }

    when anything fails with RigError as error {
        reply text explain(error) as "text/plain; charset=utf-8" status 400
    }

    route get "/" {
        reply file "web/dist/index.html"
    }

    route get "/packages/{name: Text}" {
        reply file "web/dist/index.html"
    }

    route get "/{*filepath}" {
        if filepath.contains("..") {
            reply text "forbidden" as "text/plain; charset=utf-8" status 403
        } else {
            reply file "web/dist/{filepath}"
        }
    }
}
