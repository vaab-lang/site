# riff — package registry at riff.vaab.dev
#
# Download / install counts are stored through the **rig** riff (SQLite),
# not fake seed numbers.
#
#   cd web && npm run build
#   vaab gather
#   RIG_DATABASE_URL=sqlite:riff-rig.db vaab serve main-riff.vaab

need rig from ./vendor/rig of RigError, ensure_schema, track_riff, count_riff, known_riff, riff_name_ok, connect, connect_with, require_env, allow_table, list, list_where, get, insert_todo, insert_profile, patch_todo_done, remove, require_user, user_view, resolve_object, health, auth_health, Client, User, UserView, Health, NewTodo, OkCount, Todo

choice ApiError {
    BadRequest(message: Text)
    Database(message: Text)
}

type ServiceHealth {
    ok: Bool
    service: Text
}

type RiffStat {
    name: Text
    downloads: Int
}

type Tracked {
    ok: Bool
    downloads: Int
}

log.info("riff registry starting (rig-backed)")

open_db() returns Db or fails ApiError {
    match env.get("RIG_DATABASE_URL") {
        when found url then match Db.connect(url) {
            when success db then {
                match ensure_schema(db) {
                    when success _ then { return db }
                    when failure error then { fail map_rig(error) }
                }
            }
            when failure error then match error {
                when Failed(message) then { fail ApiError.Database(message) }
            }
        }
        when nothing then match Db.connect("sqlite:riff-rig.db") {
            when success db then {
                match ensure_schema(db) {
                    when success _ then { return db }
                    when failure error then { fail map_rig(error) }
                }
            }
            when failure error then match error {
                when Failed(message) then { fail ApiError.Database(message) }
            }
        }
    }
}

map_rig(error: RigError) returns ApiError {
    match error {
        when Missing(name) then { return ApiError.BadRequest("missing {name}") }
        when Database(message) then { return ApiError.Database(message) }
        when Unauthorized then { return ApiError.BadRequest("unauthorized") }
        when BadRequest(message) then { return ApiError.BadRequest(message) }
        when NotFound(resource) then { return ApiError.BadRequest("not found: {resource}") }
        when Forbidden(table) then { return ApiError.BadRequest("forbidden {table}") }
        when Unsafe(requested) then { return ApiError.BadRequest("unsafe {requested}") }
    }
}

read_downloads(name: Text) returns Int or fails ApiError {
    if not riff_name_ok(name) {
        fail ApiError.BadRequest("riff not found")
    }
    let db = try open_db()
    match count_riff(db, name) {
        when success n then { return n }
        when failure error then { fail map_rig(error) }
    }
}

track_download(name: Text) returns Tracked or fails ApiError {
    if not riff_name_ok(name) {
        fail ApiError.BadRequest("riff not found")
    }
    let db = try open_db()
    match track_riff(db, name, "install") {
        when success _ then {
            let downloads = try read_downloads(name)
            return Tracked.new(ok: yes, downloads: downloads)
        }
        when failure error then { fail map_rig(error) }
    }
}

list_stats() returns [RiffStat] or fails ApiError {
    let supabase = try read_downloads("supabase")
    let tape = try read_downloads("tape")
    let rig_count = try read_downloads("rig")
    return [
        RiffStat.new(name: "supabase", downloads: supabase),
        RiffStat.new(name: "tape", downloads: tape),
        RiffStat.new(name: "rig", downloads: rig_count),
    ]
}

riff_detail(name: Text) returns RiffStat or fails ApiError {
    let downloads = try read_downloads(name)
    return RiffStat.new(name: name, downloads: downloads)
}

explain(error: ApiError) returns Text {
    match error {
        when BadRequest(message) then { return message }
        when Database(message) then { return message }
    }
}

serve on port 8787 {
    before every request {
        log.info("incoming {request.method} {request.path}")
    }

    route get "/health" {
        reply with ServiceHealth.new(ok: yes, service: "riff")
    }

    route get "/api/riffs" {
        reply with try list_stats()
    }

    route get "/api/riffs/{name: Text}" {
        reply with try riff_detail(name)
    }

    route post "/api/riffs/{name: Text}/track" {
        reply with try track_download(name)
    }

    when anything fails with ApiError as error {
        reply text explain(error) as "text/plain; charset=utf-8" status 400
    }

    route get "/" {
        reply file "web/dist/index.html"
    }

    route get "/packages/{name: Text}" {
        reply file "web/dist/index.html"
    }

    route get "/{*filepath}" {
        if filepath.contains("..") {
            reply text "forbidden" as "text/plain; charset=utf-8" status 403
        } else {
            reply file "web/dist/{filepath}"
        }
    }
}
